#include <stdio.h>
#include <stdlib.h>
#include <ctype.h>
#include <math.h>

#define MAX 100

struct IntStack {
    int top;
    int arr[MAX];
};

void initStack(struct IntStack* s) {
    s->top = -1;
}

int isEmpty(struct IntStack* s) {
    return s->top == -1;
}

int isFull(struct IntStack* s) {
    return s->top == MAX - 1;
}

void push(struct IntStack* s, int item) {
    if (!isFull(s)) {
        s->arr[++(s->top)] = item;
    }
}

int pop(struct IntStack* s) {
    if (!isEmpty(s)) {
        return s->arr[(s->top)--];
    }
    return 0;
}

int evaluatePostfix(char* exp) {
    struct IntStack s;
    initStack(&s);

    for (int i = 0; exp[i] != '\0'; i++) {
        char c = exp[i];

        if (c == ' ' || c == '\t') continue;

        if (isdigit(c)) {
            push(&s, c - '0');
        } 
        else {
            int val2 = pop(&s);
            int val1 = pop(&s);

            switch (c) {
                case '+': push(&s, val1 + val2); break;
                case '-': push(&s, val1 - val2); break;
                case '*': push(&s, val1 * val2); break;
                case '/': push(&s, val1 / val2); break;
                case '^': push(&s, (int)pow(val1, val2)); break;
            }
        }
    }
    return pop(&s);
}

int main() {
    char postfix[MAX] = "53+2*84/-";

    int result = evaluatePostfix(postfix);

    printf("Postfix Expression: %s\n", postfix);
    printf("Evaluated Result: %d\n", result);

    return 0;
}
